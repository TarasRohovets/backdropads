{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // PostgreSQL. In Docker Compose this comes from the environment (ConnectionStrings__PostgresConnection).
  "ConnectionStrings": {
    "PostgresConnection": ""
  },

  // Media storage. Default: a folder (Storage:Folder, a Docker volume in Compose), served at /media.
  // Set Azure:BlobConnectionString + Azure:ContainerName to use Azure Blob Storage instead.
  "Storage": {
    "Folder": ""
  },
  "Azure": {
    "BlobConnectionString": "",
    "ContainerName": ""
  },

  // Only needed when the web app is served from another origin than this API.
  "Cors": {
    "Origins": []
  },

  "AI": {
    // true = demo mode: nothing is sent to a provider and results are placeholders.
    "UseMockData": false,
    // Pre-selected model for new image / video generations (any id from GET /api/catalog).
    "DefaultModels": { "Image": "nano-banana-pro", "Video": "auto" },
    // "Auto" walks these in order, skipping models without an API key.
    "ImageProviderChain": [ "gpt-image-flare", "nano-banana", "mock" ],
    "ImageEditProviderChain": [ "nano-banana", "gpt-image-sunburst", "mock" ],
    "VideoProviderChain": [ "seedance", "gemini-omni-flash", "mock" ],
    "UgcVideoProviderChain": [ "omnihuman", "seedance", "gemini-omni-flash", "mock" ],
    // Model versions: the newest of each family in Nov 2026. "Update models" in Settings → System moves them
    // forward for you (saved in the database, on top of these values).
    "OpenAI": {
      "ApiKey": "",
      "FlareModel": "gpt-image-2.6-flare",
      "SunburstModel": "gpt-image-2.6-sunburst",
      "EditModel": "gpt-image-2.6-sunburst",
      "TtsModel": "gpt-4o-mini-tts",
      "TtsVoice": "alloy"
    },
    "Google": {
      "ApiKey": "",
      "ImageModel": "gemini-nano-banana-2.1",
      "ImageProModel": "gemini-3-pro-image",
      "VideoModel": "gemini-omni-1.2-flash"
    },
    // Claude does all text work. Today: reading attached PDFs / text into brief notes for image & video prompts.
    "Anthropic": {
      "ApiKey": "",
      "TextModel": "claude-sonnet-5-5",
      // Ceiling on what one text request may read (about $0.08 with Sonnet 5.5). Longer attachments are left out.
      "MaxInputTokens": 40000
    },
    "Seedance": {
      "ApiKey": "",
      "Model": "dreamina-seedance-2-5-260628",
      "FlashModel": "dreamina-seedance-2-5-flash-261115",
      "BaseUrl": ""
    },
    "Kling": {
      "AccessKey": "",
      "SecretKey": "",
      "Model": "kling-v3"
    },
    "Fal": {
      "ApiKey": "",
      "Apps": {
        "seedream": "bytedance/seedream/v5.5/text-to-image",
        "seedream-flash": "bytedance/seedream/v5/flash/text-to-image",
        "flux": "blackforestlabs/flux-3/text-to-image",
        "wan": "alibaba/wan-3.0/text-to-video",
        "omnihuman": "bytedance/omnihuman/v2"
      }
    }
  },

  // Per-user caps that protect your AI provider bill.
  "RateLimits": {
    "GlobalPerMinutePerIp": 600,
    "ImagePerHour": 60,
    "ImagePerDay": 300,
    "VideoPerHour": 10,
    "VideoPerDay": 40,
    "RoastPerHour": 30,
    "RoastPerDay": 100,
    "MaxConcurrentImageGenerations": 3,
    "MaxConcurrentVideoGenerations": 2,
    // The queue: AI jobs running at once. Everything else waits its turn (raise these on a bigger machine).
    "GlobalConcurrentImageJobs": 2,
    "GlobalConcurrentVideoJobs": 1
  }
}
