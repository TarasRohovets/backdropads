# Copy to .env and fill in what you have. Only one image provider is needed to start (Google or OpenAI).
# Restart after changes:  docker compose up -d

# ── AI providers (you pay them directly; BackdropAds adds nothing on top) ─────────────────────────
# Google Gemini API — Nano Banana and Nano Banana Pro (images), Gemini Omni (video), reading attached PDFs and text.
#   https://aistudio.google.com/apikey   (image and video models need billing enabled)
GOOGLE_API_KEY=

# OpenAI — GPT Image Flare and Sunburst, image edits, voiceover.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional providers. Keep comments on their own lines: anything after "=" is read as the value.
# BytePlus ModelArk — Seedance video
SEEDANCE_API_KEY=
# Kling video
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# fal — Seedream, FLUX, Wan, OmniHuman
FAL_API_KEY=

# ── Instance ─────────────────────────────────────────────────────────────────────────────────────
# true = demo mode: no AI calls, placeholder results (handy to look around without keys).
AI_USE_MOCK=false

# Port the app is served on.
WEB_PORT=3000

# Who can reach the app. 127.0.0.1 = only this computer (recommended: there is no sign-in).
# 0.0.0.0 = every device that can reach this machine. Anyone who can open the app can spend your AI keys,
# so only do that on a network you trust or behind your own protection (see README, Security).
BIND_ADDRESS=127.0.0.1

# Database password (only reachable inside the Docker network).
POSTGRES_PASSWORD=backdropads
